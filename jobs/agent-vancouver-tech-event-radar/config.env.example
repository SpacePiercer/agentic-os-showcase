# cp config.env.example config.env && chmod 600 config.env

# Auth: a long-lived OAuth token from `claude setup-token` (valid ~1 year, no
# refresh needed, bills your Claude subscription). Not the interactive login
# session, which can fail to refresh under cron.
CLAUDE_CODE_OAUTH_TOKEN=

# Target
RADAR_CITY="Metro Vancouver, British Columbia"
RADAR_HOME="Downtown Vancouver"
RADAR_WINDOW_DAYS=9

# Run tuning
RADAR_MODEL=claude-opus-4-6
RADAR_MAX_TURNS=80
RADAR_MIN_FIT=3

# Cron has no PATH to your node install. Point this at the dir holding `claude`.
#   $ dirname "$(which claude)"
RADAR_NODE_BIN="$HOME/.local/bin"

# Telegram: new/changed events only. Leave empty for report-only.
# Bot from @BotFather, added to the group. Group chat ids start with -100.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
